{
  "name": "kritya",
  "version": "0.4.0",
  "description": "Kritya — a lean, provider-agnostic terminal coding agent (NVIDIA, OpenAI, OpenRouter, Groq, Ollama, and more)",
  "type": "module",
  "bin": {
    "kritya": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/index.tsx",
    "test": "npm run build && node --test \"dist/test/*.test.js\"",
    "test:watch": "tsx --test --watch \"src/test/*.test.ts\"",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:install-scripts": "node scripts/check-install-scripts.mjs",
    "link": "npm run build && npm link",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "cli",
    "coding-agent",
    "terminal",
    "ai",
    "llm",
    "nvidia",
    "openai-compatible",
    "mcp"
  ],
  "license": "MIT",
  "dependencies": {
    "docx": "^9.7.1",
    "exceljs": "^4.4.0",
    "fast-glob": "^3.3.2",
    "ink": "^5.0.1",
    "ink-text-input": "^6.0.0",
    "jszip": "^3.10.1",
    "mammoth": "^1.12.0",
    "openai": "^4.77.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^4.8.69",
    "pptxgenjs": "^4.0.1",
    "react": "^18.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.9.0",
    "@types/node": "^20.14.0",
    "@types/react": "^18.3.3",
    "eslint": "^9.9.0",
    "globals": "^14.0.0",
    "prettier": "^3.3.0",
    "tsx": "^4.16.0",
    "typescript": "^5.5.0",
    "typescript-eslint": "^8.0.0"
  },
  "overrides": {
    "exceljs": {
      "uuid": "^11.1.1"
    }
  }
}
