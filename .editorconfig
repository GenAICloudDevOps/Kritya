# Editors on Windows default to CRLF. `.gitattributes` normalizes line endings
# on checkout, but that only governs what git writes — an editor still saves
# CRLF into the working tree, and `format:check` then fails in CI (per-OS, so
# the Windows leg catches it) on a diff that has nothing to do with what the
# contributor actually changed. Setting it here stops the mismatch at the
# source instead of at the gate.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.md]
# Two trailing spaces are a hard line break in Markdown, so stripping them
# silently changes rendering.
trim_trailing_whitespace = false

# Windows-native formats that genuinely require CRLF.
[*.{bat,cmd,ps1}]
end_of_line = crlf

[{Makefile,*.mk}]
indent_style = tab
