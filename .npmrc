# Intake rules for every npm install in this repo — local, CI, and scripts.
#
# min-release-age: only install package versions published at least 3 days
# ago. Matches the Dependabot cooldown in .github/dependabot.yml, but applies
# to manual installs too, not just Dependabot's. One-off exception for an
# urgent fix, on the command line only (the file itself stays unchanged):
#   npm install <pkg>@<version> --min-release-age=0
# (Only npm 11.10+ understands this setting; older npm ignores it.)
min-release-age=3
#
# ignore-scripts: never run install scripts shipped by dependencies. Only
# three packages in the tree declare one (esbuild, fsevents,
# electron-winstaller — the install-script allowlist), and the
# check:install-scripts CI gate fails if any other package gains one.
# Note: this also skips the repo's own `prepare` (husky) on install — on a
# fresh clone, run `npm run prepare` once to install the git hooks.
ignore-scripts=true
